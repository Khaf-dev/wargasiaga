# Firebase SDK (public, aman di frontend)
VITE_FIREBASE_API_KEY="xxx"
VITE_FIREBASE_AUTH_DOMAIN="xxx.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="xxx"
VITE_FIREBASE_STORAGE_BUCKET="xxx.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="xxx"
VITE_FIREBASE_APP_ID="xxx"

# Supabase (public, RLS akan handle security)
VITE_SUPABASE_URL="https://xxx.supabase.co"
VITE_SUPABASE_ANON_KEY="xxx"

# Google Maps API Key (public, batasi via GCP console by HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY="xxx"

VITE_API_BASE_URL="http://localhost:8000/api/v1"

# ... (keys yang lain)
# Dapatkan dari Firebase Console > Project Settings > Cloud Messaging > Web configuration
VITE_FIREBASE_VAPID_KEY="Bxxxx_xxx_your_vapid_key_here_xxxx"